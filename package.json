{
  "name": "prmonitor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "tools/spec-linter",
    "packages/validation-contract"
  ],
  "scripts": {
    "build": "npm run build:validation-contract && npm run build:spec-linter",
    "build:validation-contract": "npm --workspace @prmonitor/validation-contract run build",
    "build:spec-linter": "npm --workspace @prmonitor/spec-linter run build",
    "lint:prd-plan": "npm --workspace @prmonitor/spec-linter run lint:prd-plan --",
    "lint:application-coverage": "npm --workspace @prmonitor/spec-linter run lint:application-coverage --",
  "generate:validation-schema": "npm --workspace @prmonitor/validation-contract run generate:schema",
  "report:validation-contract": "npm --workspace @prmonitor/validation-contract run conformance:report",
    "test:validation-contract": "npm --workspace @prmonitor/validation-contract run test",
    "test:spec-linter": "npm --workspace @prmonitor/spec-linter run test",
    "test": "npm run test:validation-contract && npm run test:spec-linter",
    "check": "npm run build && npm test"
  }
}
