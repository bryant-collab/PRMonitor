{
  "name": "@prmonitor/spec-linter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint:prd-plan": "tsx src/cli.ts",
    "lint:application-coverage": "tsx src/application-cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
